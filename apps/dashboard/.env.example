# Salin ke .env.local. Jangan commit file .env.local.
# Semua variabel frontend wajib diawali VITE_ dan TIDAK boleh berisi secret.

# Label mode dashboard (latihan | operasional). Pada prototipe selalu latihan.
VITE_APP_MODE=latihan

# Sumber simulasi: mock (prototipe) | api (tahap backend)
VITE_SIMULATION_SOURCE=mock

# Sumber narasi LLM: mock (prototipe) | proxy (tahap backend, FR-R7)
VITE_LLM_SOURCE=mock
